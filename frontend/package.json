{
  "name": "lms-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "LMS frontend (Next.js App Router, RTL-first, React Three Fiber)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "audit:deps": "npm audit --omit=dev",
    "api:types": "openapi-typescript ../openapi.json -o src/lib/api/openapi.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-kufi-arabic": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-query": "5.104.2",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
