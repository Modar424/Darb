# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser; keep everything else server-side.

# Where the Next.js server proxies /api/v1/* to (server-side only, not exposed to the browser).
API_INTERNAL_URL=http://localhost:3001

# Optional: public site URL used for metadata (canonical/Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
