# Copy to .env and adjust. NEVER commit real secrets.
NODE_ENV=development
PORT=3001
APP_PUBLIC_URL=http://localhost:3000

# MySQL (use a least-privilege account in production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lms
DB_PASSWORD="MySql@2027#modar"
DB_NAME=lms_dev
DB_SSL=false

# Browser origins allowed to call the API with credentials (comma separated, no wildcard)
CORS_ORIGINS=http://localhost:3000

# Sessions (opaque, server-side, stored in MySQL; cookie is HttpOnly)
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL_MINUTES=720
SESSION_ABSOLUTE_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30

# Brute-force protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# Argon2id parameters (OWASP minimum: 19456 KiB, 2 iterations, 1 lane)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# Misc
BODY_LIMIT=256kb
TRUST_PROXY=false
SWAGGER_ENABLED=true
LOG_LEVEL=info
# console = prints reset link to stdout (development ONLY, rejected in production); none = discard
MAIL_TRANSPORT=console

# Seed (fictional data only)
SEED_PASSWORD=Salamieh-Darb123
